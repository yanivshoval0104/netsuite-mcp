## NetSuite Token-Based Authentication (TBA / OAuth 1.0a) config
NETSUITE_ACCOUNT_ID=1234567_SB1
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

## Remote (Render) deployment only — used by src/httpServer.js, not by the local stdio server
# Optional bearer token: if set, every request to /mcp must send "Authorization: Bearer <token>"
MCP_SERVER_TOKEN=
# Render sets PORT automatically; only needed for local HTTP testing
PORT=3000

## SDF (SuiteCloud Development Framework) tools only — src/registerSdfTools.js, local/stdio server only.
## SEPARATE credential set: OAuth 2.0 Client Credentials (M2M certificate), NOT the TBA vars above.
## TBA is not accepted for SuiteCloud CLI CI auth as of NetSuite 2024.2 — see NETSUITE_ADMIN_SETUP.md steps 4-6.
NETSUITE_SDF_AUTH_ID=netsuite-mcp-ci
NETSUITE_SDF_CERTIFICATE_ID=
NETSUITE_SDF_PRIVATE_KEY_PATH=./secrets/netsuite_private.pem
